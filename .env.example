# Copy this file to .env and fill in real values before running anything.
# Never commit the real .env file - it holds secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# The domain this instance is deployed at. Used by the production deploy
# scripts to render the Nginx config and request the Let's Encrypt
# certificate - it must already have a DNS A/AAAA record pointing at this
# server before you run scripts/setup-ssl.sh.
DOMAIN=example.com

# Restrict browser CORS to your own frontend origin in production.
# The prod compose file derives this from DOMAIN automatically; only
# override it if you serve a frontend from a different origin.
CORS_ORIGIN=https://example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=pro_auth
DATABASE_USER=pro_auth
# Generate a strong password, e.g.: openssl rand -base64 32
DATABASE_PASSWORD=change-me

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Accounting
# ---------------------------------------------------------------------------
BASE_CURRENCY=USD

# ---------------------------------------------------------------------------
# SMTP (used for email verification, password reset, and admin notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASSWORD=change-me
SMTP_FROM="Corporate ERP <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Storage (paths inside the app container - do not change unless you also
# change the volume mounts in docker-compose.*.yml)
# ---------------------------------------------------------------------------
FILE_STORAGE_PATH=/app/storage/files
REPORT_STORAGE_PATH=/app/storage/reports

# ---------------------------------------------------------------------------
# Admin bootstrap (only used by `npm run seed:admin` / seed:admin:prod)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
